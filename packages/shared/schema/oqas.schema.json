{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open QA Stack solo-mode configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "applications",
    "knowledge",
    "model"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "formatVersion": {
      "const": 1,
      "description": "Version of the file format, independent of the product version."
    },
    "applications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/application"
      }
    },
    "knowledge": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/knowledge"
      }
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "charter": {
      "$ref": "#/$defs/charter"
    },
    "cartography": {
      "$ref": "#/$defs/cartography"
    },
    "design": {
      "$ref": "#/$defs/design"
    },
    "model": {
      "$ref": "#/$defs/model"
    },
    "autonomy": {
      "$ref": "#/$defs/autonomy"
    }
  },
  "$defs": {
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application"
      ],
      "properties": {
        "application": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "api": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "authentication",
        "environments"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "web",
            "api",
            "web-and-api"
          ]
        },
        "authentication": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method"
          ],
          "properties": {
            "method": {
              "enum": [
                "none",
                "form"
              ]
            },
            "accounts": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "usernameEnv",
                  "passwordEnv"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "usernameEnv": {
                    "type": "string",
                    "pattern": "^[A-Z_][A-Z0-9_]*$",
                    "description": "Name of an environment variable. The value itself is never written in the file."
                  },
                  "passwordEnv": {
                    "type": "string",
                    "pattern": "^[A-Z_][A-Z0-9_]*$",
                    "description": "Name of an environment variable. The value itself is never written in the file."
                  }
                }
              }
            }
          }
        },
        "environments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/environment"
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "uiUrl": {
          "type": "string",
          "minLength": 1,
          "description": "Absolute http or https URL, without credentials."
        },
        "exploration": {
          "enum": [
            "read-only",
            "read-write"
          ],
          "description": "What the agent that explores the user interface may do in this environment: `read-only`, the default, it changes no data; `read-write`, it may submit the forms that create or change data, never those that remove any."
        },
        "apis": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "baseUrl"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "baseUrl": {
                "type": "string",
                "minLength": 1,
                "description": "Absolute http or https URL, without credentials."
              }
            }
          }
        }
      }
    },
    "knowledge": {
      "type": "object",
      "discriminator": {
        "propertyName": "type"
      },
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "attachments"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "attachments": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/attachment"
              }
            },
            "type": {
              "const": "openapi"
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "description": "Absolute http or https URL, without credentials."
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "Path relative to the test repository root, which it may not leave."
            }
          },
          "oneOf": [
            {
              "required": [
                "url"
              ]
            },
            {
              "required": [
                "path"
              ]
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "attachments",
            "connectionStringEnv"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "attachments": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/attachment"
              }
            },
            "type": {
              "const": "postgresql"
            },
            "connectionStringEnv": {
              "type": "string",
              "pattern": "^[A-Z_][A-Z0-9_]*$",
              "description": "Name of an environment variable. The value itself is never written in the file."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "attachments",
            "path"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "attachments": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/attachment"
              }
            },
            "type": {
              "const": "document"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "Path relative to the test repository root, which it may not leave."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "attachments",
            "path"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "attachments": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/attachment"
              }
            },
            "type": {
              "const": "source-code"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "Path relative to the test repository root; it may lead outside, to code kept in another repository."
            },
            "commands": {
              "enum": [
                "none",
                "git",
                "shell"
              ],
              "description": "Commands the agents may run in the folder: none, git history only (the default), or any shell command."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "attachments"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "attachments": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/attachment"
              }
            },
            "type": {
              "const": "logs"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "Log file, relative to the test repository root; it may lead outside."
            },
            "container": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "description": "Name of the container whose logs are read."
            },
            "engine": {
              "enum": [
                "podman",
                "docker"
              ],
              "description": "Container engine whose command reads the logs of the container."
            }
          },
          "oneOf": [
            {
              "required": [
                "path"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "container"
                    ]
                  },
                  {
                    "required": [
                      "engine"
                    ]
                  }
                ]
              }
            },
            {
              "required": [
                "container",
                "engine"
              ],
              "not": {
                "required": [
                  "path"
                ]
              }
            }
          ]
        }
      ]
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "appsDir": {
          "type": "string",
          "minLength": 1,
          "description": "Path relative to the test repository root, which it may not leave."
        },
        "blocksDir": {
          "type": "string",
          "minLength": 1,
          "description": "Path relative to the test repository root, which it may not leave."
        },
        "journeysDir": {
          "type": "string",
          "minLength": 1,
          "description": "Path relative to the test repository root, which it may not leave."
        },
        "stateDir": {
          "type": "string",
          "minLength": 1,
          "description": "Path relative to the test repository root, which it may not leave."
        },
        "indexDir": {
          "type": "string",
          "minLength": 1,
          "description": "Path relative to the test repository root, which it may not leave."
        }
      }
    },
    "cartography": {
      "type": "object",
      "additionalProperties": false,
      "description": "How the sources are mapped.",
      "properties": {
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "description": "Most sources mapped at once, each in its own task; one by default."
        }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "description": "How the tests are designed.",
      "properties": {
        "reviewPlan": {
          "type": "boolean",
          "description": "Whether an agent of its own reviews the scenarios of a plan for duplicates, in sessions of the model of their own; true by default. The harness compares the scenarios by their code either way."
        },
        "levels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "smoke",
              "functional",
              "business",
              "cross-application",
              "end-to-end"
            ]
          },
          "description": "The levels of the pyramid of tests a plan is asked for, from its base to its top: smoke, the application answers; functional, one behaviour of one screen; business, a journey through several screens; cross-application, an action in an application and its effect in another; end-to-end, a journey through three applications or more. smoke, functional and business by default."
        }
      }
    },
    "charter": {
      "type": "object",
      "additionalProperties": false,
      "description": "Changes to the default test charter the designer and the reviewer apply.",
      "properties": {
        "disable": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule",
              "reason"
            ],
            "properties": {
              "rule": {
                "type": "string",
                "pattern": "^[A-Z]+(-[A-Z0-9]+)+$"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "add": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "statement",
              "reason"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Z]+(-[A-Z0-9]+)+$"
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "model": {
      "type": "object",
      "discriminator": {
        "propertyName": "mode"
      },
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "provider",
            "baseUrl",
            "model"
          ],
          "properties": {
            "mode": {
              "const": "provider-key"
            },
            "provider": {
              "enum": [
                "openai"
              ]
            },
            "baseUrl": {
              "type": "string",
              "minLength": 1,
              "description": "Absolute http or https URL, without credentials."
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "apiKeyEnv": {
              "type": "string",
              "pattern": "^[A-Z_][A-Z0-9_]*$",
              "description": "Name of an environment variable. The value itself is never written in the file."
            },
            "capabilities": {
              "type": "array",
              "items": {
                "enum": [
                  "vision"
                ]
              },
              "description": "What the model can do besides reading and writing text: `vision`, it reads images."
            },
            "requestTimeoutSeconds": {
              "type": "integer",
              "minimum": 1,
              "description": "Longest wait for the answer of the model to one request, in seconds; 120 by default. A request left without answer is sent once more."
            },
            "reasoningEffort": {
              "type": "string",
              "minLength": 1,
              "description": "How much the model reasons before it answers, in a word of its server, such as `none`, `low` or `high`; sent with every request when set."
            }
          }
        }
      ]
    },
    "autonomy": {
      "type": "object",
      "discriminator": {
        "propertyName": "level"
      },
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level"
          ],
          "properties": {
            "level": {
              "const": "autonomous"
            },
            "guardrailMinutes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level",
            "task"
          ],
          "properties": {
            "level": {
              "const": "bounded"
            },
            "task": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "maxMinutes": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxIterations": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxActions": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "guardrailMinutes": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    }
  }
}
