{
  "name": "@open-qa-stack/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./src/api-entry.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "node --eval \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/src/main.js",
    "migrate": "node --enable-source-maps dist/src/migrate.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm -s build && node dist/test/support/with-test-database.js node --test --enable-source-maps --import @open-qa-stack/testing/loopback-only --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-include='**/src/**' --test-coverage-exclude='../**' 'dist/test/**/*.test.js'"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.7",
    "@fastify/static": "10.1.11",
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-fastify": "12.4.2",
    "@open-qa-stack/domain": "workspace:*",
    "@open-qa-stack/engine": "workspace:*",
    "@open-qa-stack/store": "workspace:*",
    "fastify": "5.12.8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.4.2",
    "@open-qa-stack/testing": "workspace:*",
    "@types/pg": "8.23.1",
    "pg": "8.23.1"
  }
}
