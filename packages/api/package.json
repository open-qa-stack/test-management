{
  "name": "@open-qa-stack/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node --eval \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/src/main.js",
    "migrate": "node --enable-source-maps dist/src/migrate.js",
    "migrations:generate": "drizzle-kit generate --dialect postgresql --schema src/database/schema.ts --out migrations",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm -s build && node dist/test/support/with-test-database.js node --test --test-concurrency=1 --enable-source-maps --import @open-qa-stack/testing/loopback-only --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-include='**/src/**' --test-coverage-exclude='../**' 'dist/test/**/*.test.js'"
  },
  "dependencies": {
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-fastify": "12.4.2",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.4.2",
    "@open-qa-stack/testing": "workspace:*",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
