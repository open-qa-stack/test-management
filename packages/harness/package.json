{
  "name": "@open-qa-stack/harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-concurrency=1 --import @open-qa-stack/testing/loopback-only --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-include='src/**' 'test/**/*.test.ts'",
    "recordings:update": "UPDATE_RECORDINGS=1 node --test --import @open-qa-stack/testing/loopback-only test/scripted-recordings.test.ts",
    "record:tool-calling": "node scripts/record-tool-calling.ts",
    "charter:doc": "node scripts/emit-charter-doc.ts"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.31",
    "@open-qa-stack/domain": "workspace:*",
    "@open-qa-stack/shared": "workspace:*",
    "ajv": "8.20.0",
    "eslint-plugin-playwright": "2.12.2",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "undici": "7.30.1"
  },
  "devDependencies": {
    "@open-qa-stack/testing": "workspace:*",
    "@open-qa-stack/tools": "workspace:*"
  }
}
