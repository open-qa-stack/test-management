{
  "name": "@open-qa-stack/check",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "c8 --reporter=lcovonly --reporter=text-summary --report-dir=\"${OQAS_COVERAGE_DIRECTORY:-coverage}\" --temp-directory=\"${OQAS_COVERAGE_DIRECTORY:-coverage}/tmp\" --include='src/**' --check-coverage --per-file --lines=100 --branches=100 --functions=100 vitest run"
  },
  "devDependencies": {
    "c8": "12.0.0"
  }
}
