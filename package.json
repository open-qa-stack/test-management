{
  "name": "open-qa-stack-poc",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck && tsc -p lint/tsconfig.json",
    "build": "pnpm -r --if-present build",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test && pnpm -s test:lint-rules",
    "test:lint-rules": "node --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-include='lint/*.ts' 'lint/test/**/*.test.ts'",
    "check": "node --disable-warning=ExperimentalWarning packages/check/src/main.ts",
    "scan": "node --disable-warning=ExperimentalWarning packages/check/src/scan-main.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  }
}
