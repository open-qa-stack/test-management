{
  "name": "open-qa-stack",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck && tsc -p lint/tsconfig.json",
    "build": "pnpm -r --if-present build",
    "lint": "oxlint --type-aware --deny-warnings && node --disable-warning=ExperimentalWarning lint/check-manifests.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "check": "node --disable-warning=ExperimentalWarning packages/check/src/main.ts",
    "scan": "node --disable-warning=ExperimentalWarning packages/check/src/scan-main.ts",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
