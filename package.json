{
  "name": "open-qa-stack",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck && tsc -p lint/tsconfig.json",
    "build": "pnpm -r --if-present build",
    "lint": "oxlint --type-aware --deny-warnings && node --disable-warning=ExperimentalWarning lint/check-manifests.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:part": "vitest run --coverage --reporter=default --reporter=blob",
    "test:merge": "vitest --merge-reports --coverage",
    "check": "node --disable-warning=ExperimentalWarning packages/check/src/main.ts",
    "scan": "node --disable-warning=ExperimentalWarning packages/check/src/scan-main.ts",
    "test:watch": "vitest",
    "test:durations": "vitest --merge-reports --reporter=json --outputFile=.vitest/report.json && node --disable-warning=ExperimentalWarning -e \"import('./packages/testing/src/test-durations.ts').then(({ writeDurations }) => writeDurations('.vitest/report.json', 'test-durations.json', process.cwd()))\""
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2008",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
