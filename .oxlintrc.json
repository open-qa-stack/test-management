{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["./lint/plugin.ts"],
  "ignorePatterns": ["**/dist/**", "**/test/fixtures/**"],
  "rules": {
    "no-control-regex": "off",
    "no-unused-vars": ["warn", { "ignoreRestSiblings": true }],
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": [{ "from": "package", "package": "node:test", "name": ["describe", "it", "suite", "test"] }]
      }
    ],
    "open-qa-stack/confined-imports": [
      "error",
      {
        "modules": {
          "@github/copilot-sdk": "packages/harness/src/copilot",
          "ink": "apps/cli/src/conversation",
          "ink-spinner": "apps/cli/src/conversation",
          "ink-text-input": "apps/cli/src/conversation"
        }
      }
    ]
  },
  "overrides": [
    {
      "files": ["apps/api/src/**", "apps/api/test/**"],
      "plugins": ["node"],
      "rules": { "node/no-process-env": "error" }
    },
    {
      "files": ["apps/api/src/config/**", "apps/api/test/support/**"],
      "plugins": ["node"],
      "rules": { "node/no-process-env": "off" }
    },
    {
      "files": ["packages/*/src/**", "apps/*/src/**"],
      "rules": {
        "open-qa-stack/package-boundaries": [
          "error",
          {
            "packages": {
              "@open-qa-stack/domain": { "directory": "packages/domain", "dependsOn": [], "external": ["ajv", "node:path"] },
              "@open-qa-stack/store": { "directory": "packages/store", "dependsOn": ["@open-qa-stack/domain"] },
              "@open-qa-stack/api": {
                "directory": "apps/api",
                "dependsOn": ["@open-qa-stack/engine", "@open-qa-stack/store", "@open-qa-stack/domain"]
              },
              "@open-qa-stack/harness": { "directory": "packages/harness", "dependsOn": ["@open-qa-stack/domain"] },
              "@open-qa-stack/tools": { "directory": "packages/tools", "dependsOn": ["@open-qa-stack/domain"] },
              "@open-qa-stack/agents": {
                "directory": "packages/agents",
                "dependsOn": ["@open-qa-stack/domain", "@open-qa-stack/tools"]
              },
              "@open-qa-stack/engine": {
                "directory": "packages/engine",
                "dependsOn": ["@open-qa-stack/harness", "@open-qa-stack/agents", "@open-qa-stack/tools", "@open-qa-stack/domain"]
              },
              "@open-qa-stack/cli": {
                "directory": "apps/cli",
                "dependsOn": [
                  "@open-qa-stack/api",
                  "@open-qa-stack/web",
                  "@open-qa-stack/engine",
                  "@open-qa-stack/store",
                  "@open-qa-stack/harness",
                  "@open-qa-stack/tools",
                  "@open-qa-stack/domain"
                ]
              },
              "@open-qa-stack/web": { "directory": "apps/web", "dependsOn": ["@open-qa-stack/domain"] }
            }
          }
        ]
      }
    },
    {
      "files": ["packages/domain/src/**"],
      "rules": { "open-qa-stack/pure-domain": "error" }
    },
    {
      "files": ["apps/web/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@open-qa-stack/domain",
                "message": "The console imports the contract of sessions, @open-qa-stack/domain/sessions, and nothing else of the domain: the rest runs on Node.js."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/cli/src/connected/**"],
      "rules": {
        "open-qa-stack/folder-boundaries": ["error", { "directory": "apps/cli/src/connected", "dependsOn": ["@open-qa-stack/domain"] }]
      }
    }
  ]
}
