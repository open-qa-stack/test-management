{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["./lint/plugin.ts"],
  "ignorePatterns": ["**/dist/**", "**/test/fixtures/**"],
  "rules": {
    "no-control-regex": "off",
    "no-unused-vars": ["warn", { "ignoreRestSiblings": true }],
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": [{ "from": "package", "package": "node:test", "name": ["describe", "it", "suite", "test"] }]
      }
    ],
    "open-qa-stack/confined-imports": ["error", { "modules": { "@github/copilot-sdk": "packages/harness/src/copilot" } }]
  },
  "overrides": [
    {
      "files": ["packages/api/src/**", "packages/api/test/**"],
      "plugins": ["node"],
      "rules": { "node/no-process-env": "error" }
    },
    {
      "files": ["packages/api/src/config/**", "packages/api/test/support/**"],
      "plugins": ["node"],
      "rules": { "node/no-process-env": "off" }
    },
    {
      "files": ["packages/*/src/**", "apps/*/src/**"],
      "rules": {
        "open-qa-stack/package-boundaries": [
          "error",
          {
            "packages": {
              "@open-qa-stack/domain": { "directory": "packages/domain", "dependsOn": [], "external": [] },
              "@open-qa-stack/shared": { "directory": "packages/shared", "dependsOn": [] },
              "@open-qa-stack/api": { "directory": "packages/api", "dependsOn": ["@open-qa-stack/domain", "@open-qa-stack/shared"] },
              "@open-qa-stack/harness": { "directory": "packages/harness", "dependsOn": ["@open-qa-stack/domain", "@open-qa-stack/shared"] },
              "@open-qa-stack/tools": { "directory": "packages/tools", "dependsOn": ["@open-qa-stack/domain", "@open-qa-stack/shared"] },
              "@open-qa-stack/agents": {
                "directory": "packages/agents",
                "dependsOn": ["@open-qa-stack/domain", "@open-qa-stack/shared", "@open-qa-stack/tools"]
              },
              "@open-qa-stack/worker": {
                "directory": "packages/worker",
                "dependsOn": ["@open-qa-stack/harness", "@open-qa-stack/agents", "@open-qa-stack/tools", "@open-qa-stack/domain", "@open-qa-stack/shared"]
              },
              "@open-qa-stack/cli": {
                "directory": "packages/cli",
                "dependsOn": ["@open-qa-stack/shared", "@open-qa-stack/harness", "@open-qa-stack/agents", "@open-qa-stack/tools", "@open-qa-stack/domain"]
              },
              "@open-qa-stack/web": { "directory": "apps/web", "dependsOn": ["@open-qa-stack/shared"] }
            }
          }
        ]
      }
    },
    {
      "files": ["packages/domain/src/**"],
      "rules": { "open-qa-stack/pure-domain": "error" }
    },
    {
      "files": ["packages/cli/src/connected/**"],
      "rules": {
        "open-qa-stack/folder-boundaries": ["error", { "directory": "packages/cli/src/connected", "dependsOn": ["@open-qa-stack/shared"] }]
      }
    }
  ]
}
